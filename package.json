{
    "name":  "zalobot-egas",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/scripts/tuoi-no.js",
                    "check":  "tsc -p tsconfig.json --noEmit",
                    "bot":  "node dist/scripts/zalo-bot.js",
                    "set-webhook":  "node dist/scripts/zalo-set-webhook.js",
                    "bot:polling":  "node dist/scripts/zalo-polling-lib.js",
                    "bot:monitor":  "node dist/scripts/zalo-monitor.js",
                    "service:install:polling":  "node dist/scripts/install-service.js polling",
                    "service:install:monitor":  "node dist/scripts/install-service.js monitor",
                    "service:uninstall:polling":  "node dist/scripts/uninstall-service.js polling",
                    "service:uninstall:monitor":  "node dist/scripts/uninstall-service.js monitor"
                },
    "dependencies":  {
                         "dotenv":  "^17.4.2",
                         "express":  "^5.2.1",
                         "node-windows":  "^1.0.0-beta.8",
                         "node-zalo-bot":  "^0.1.6",
                         "playwright":  "^1.55.0"
                     },
    "devDependencies":  {
                            "@types/express":  "^5.0.6",
                            "@types/node":  "^26.2.0",
                            "typescript":  "^5.9.0"
                        }
}
